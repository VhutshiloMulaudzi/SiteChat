# Use real values only in a local .env file; never commit credentials.
# ASP.NET Core does not automatically load .env. Export these variables or use Docker --env-file.
PORT=3000
# Independent OpenAI-compatible hosting: base URL MUST include /v1.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-your-own-server-side-key
AI_MODEL=replace-with-a-model-supported-by-your-provider
# Optional provider extension; leave unset for providers that do not support reasoning.
# AI_REASONING_EFFORT=low
# Add allowed website origins for the demo bot (scheme + host + port, no trailing slash).
SiteChat__Sites__demo__Origins__0=https://www.example.com
# Add another bot entirely on the server:
# SiteChat__Sites__support__Origins__0=https://shop.example.com
# SiteChat__Sites__support__SystemPrompt=You are our shop assistant. Add verified business facts here.
# Manus-managed hosting injects MANUS_API_URL and MANUS_API_KEY automatically.
